{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension (open test/fixture)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${workspaceFolder}/test/fixture"
      ]
    },
    {
      "name": "Run Extension (empty window)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}"
      ]
    }
  ]
}
